{
  "name": "civilization-dapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 31057",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint",
    "build:demo": "pnpm --filter @civilization/demo build",
    "preflight:worldchain:mainnet": "node scripts/deploy-worldchain-mainnet.mjs",
    "preflight:worldchain:testnet": "node scripts/deploy-worldchain-testnet.mjs",
    "deploy:worldchain:testnet": "CONFIRM_TESTNET_DEPLOY=yes node scripts/deploy-worldchain-testnet.mjs --send",
    "test:worldchain:testnet": "node scripts/test-worldchain-sepolia-e2e.mjs",
    "run:worldchain:testnet": "CONFIRM_TESTNET_E2E=yes node scripts/test-worldchain-sepolia-e2e.mjs --send",
    "deploy:worldchain:mainnet": "CONFIRM_MAINNET_DEPLOY=yes node scripts/deploy-worldchain-mainnet.mjs --send"
  },
  "devDependencies": {
    "@ethereumjs/block": "10.1.2",
    "@ethereumjs/util": "10.1.2",
    "@ethereumjs/vm": "10.1.2",
    "@eslint/eslintrc": "^3.3.1",
    "solc": "0.8.30",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "eruda": "^3.4.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-config-next": "15.5.9",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@worldcoin/idkit": "^4.2.2",
    "@worldcoin/mini-apps-ui-kit-react": "^1.0.2",
    "clsx": "^2.1.1",
    "iconoir-react": "^7.11.0",
    "@worldcoin/idkit-core": "^4.2.3",
    "@worldcoin/minikit-js": "^2.0.3",
    "@worldcoin/minikit-react": "2.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "next": "15.5.9",
    "next-auth": "5.0.0-beta.32",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.2.0",
    "viem": "^2.55.11"
  }
}
