# Public Mini App values, read by the Next server at runtime and passed to the client as props.
WORLD_APP_ID=app_replace_with_mini_app_id
WORLD_ID_APP_ID=app_replace_with_world_id_app_id
WORLD_ID_ACTION=play
WORLD_ID_PROOF_CONTEXT_URL=https://civilization.nyphon.de/api/rp-signature
WORLD_ID_ENVIRONMENT=production

# NextAuth / SIWE. Generate distinct random values of at least 32 bytes.
AUTH_URL=https://civilization.nyphon.de
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-random-nextauth-secret
HMAC_SECRET_KEY=replace-with-separate-random-wallet-nonce-secret

# World ID v4 relying party. RP_ID is public; signing key is server-only.
RP_ID=rp_a84548cb908798cf
RP_SIGNING_KEY=replace-with-world-developer-portal-rp-signing-key

# World Chain mainnet registration gate.
CIVILIZATION_CONTRACT_ADDRESS=0x0E6689d0649Ad9037465d178231b10F18518D2b0

# PostgreSQL stores only short-lived Wallet Auth challenges and login tickets.
# Run `pnpm db:migrate` once before starting the application.
# All game state remains in CivilizationGame on World Chain.
PGHOST=postgres
PGPORT=5432
PGDATABASE=civilization
PGUSER=civilization
POSTGRES_PASSWORD=replace-with-secret
