# Public World Developer Portal app identifier. This is a GitHub Actions variable, not a secret.
VITE_WORLD_APP_ID=app_replace_after_portal_setup
# Optional separate World ID app identifier. Omit it when Mini App and World ID use the same Portal app.
# VITE_WORLD_ID_APP_ID=app_replace_after_portal_setup
# Short, stable Portal action identifier.
VITE_WORLD_ID_ACTION=play
# Set this only after the reviewed World Chain deployment succeeds.
VITE_CIVILIZATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Public HTTPS endpoint of the backend that signs World ID RP context. It has no proof-verification or game authority.
VITE_WORLD_ID_PROOF_CONTEXT_URL=https://api.example.com/world-id/proof-context
# Civilization DApp's Portal application is production. Do not set this to staging without matching Portal/RP config.
VITE_WORLD_ID_ENVIRONMENT=production

# Optional local/test build only. World App itself cannot transact on testnet.
# Use an external EVM wallet and never copy these values into a production build.
# VITE_CIVILIZATION_NETWORK=worldchain-sepolia
# VITE_CIVILIZATION_CONTRACT_ADDRESS=0xfCdB50926c3c6b2CDF3ACE76B13c9383A2DC3199
# VITE_CIVILIZATION_TESTNET_WORLD_TOKEN=0x29147C7BEAd901E8019d7911A7DC404447877C62
# VITE_CIVILIZATION_TESTNET_WORLD_ID_VERIFIER=0x1A64F89881FD2E38255E62c6D62b68076052DF4b

# TrueNAS Civilization DApp service. Keep these server-only; do not use a VITE_ prefix.
# `WORLD_ID_RP_ID` is public, but its signing key is secret and must live only
# in protected server configuration. The endpoint signs context for this fixed
# action; it never receives game-state authority or a wallet private key.
WORLD_ID_RP_ID=rp_replace_after_portal_setup
WORLD_ID_ACTION=play
WORLD_ID_RP_SIGNING_KEY=replace-with-server-only-secret
# Optional; must be 60..600 seconds. Default 300.
# WORLD_ID_RP_CONTEXT_TTL_SECONDS=300
# Use discrete PG variables so a strong password needs no URL encoding.
PGHOST=postgres
PGPORT=5432
PGDATABASE=idlemint
PGUSER=idlemint
PGPASSWORD=replace-with-secret
