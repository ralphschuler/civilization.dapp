# Public World Developer Portal app identifier. This is a GitHub Actions variable, not a secret.
VITE_WORLD_APP_ID=app_replace_after_portal_setup
# Public HTTPS endpoints of the trusted backend. The backend owns RP signing and proof verification.
VITE_WORLD_ID_PROOF_CONTEXT_URL=https://api.example.com/world-id/proof-context
VITE_WORLD_ID_VERIFY_URL=https://api.example.com/world-id/verify
# Civilization DApp's Portal application is production. Do not set this to staging without matching Portal/RP config.
VITE_WORLD_ID_ENVIRONMENT=production

# TrueNAS Civilization DApp service. Keep these server-only; do not use a VITE_ prefix.
# Use discrete PG variables so a strong password needs no URL encoding.
PGHOST=postgres
PGPORT=5432
PGDATABASE=idlemint
PGUSER=idlemint
PGPASSWORD=replace-with-secret
