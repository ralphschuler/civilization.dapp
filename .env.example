# Public Mini App values, read by the Next server at runtime and passed to the client as props.
CIVILIZATION_ENV=production
WORLD_APP_ID=app_replace_with_mini_app_id

# WalletAuth/SIWE origin. This must exactly match the public Mini App origin.
WALLET_AUTH_URL=https://civilization.example.invalid

# World Chain mainnet registration gate.
CIVILIZATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CIVILIZATION_CHAIN_ID=480
CIVILIZATION_WORLD_TOKEN_ADDRESS=0x2cFc85d8E48F8EAB294be644d9E25C3030863003

# PostgreSQL stores short-lived WalletAuth/SIWE challenges and opaque session
# hashes. Wallet addresses are checksummed; signatures and wallet secrets are
# never persisted.
# Run `pnpm db:migrate` once before starting the application.
# All game state remains in CivilizationGame on World Chain.
PGHOST=postgres
PGPORT=5432
PGDATABASE=civilization
PGUSER=civilization
POSTGRES_PASSWORD=replace-with-a-local-password
