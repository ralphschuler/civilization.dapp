# Isolated development Mini App. Replace every placeholder in protected runtime configuration.
CIVILIZATION_ENV=development
AUTH_URL=https://replace-with-dev-host.example
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-dev-auth-secret
HMAC_SECRET_KEY=replace-with-dev-wallet-nonce-hmac-secret
WORLD_APP_ID=app_c098bd46180834e598bd9cac8d1bd94d
WORLD_ID_APP_ID=app_c098bd46180834e598bd9cac8d1bd94d
WORLD_ID_ACTION=civilization-dev-play
WORLD_ID_PROOF_CONTEXT_URL=https://replace-with-dev-host.example/api/rp-signature
WORLD_ID_ENVIRONMENT=production
RP_ID=rp_de35f1ecb30715f9
RP_SIGNING_KEY=replace-with-dev-rp-signing-key
CIVILIZATION_CONTRACT_ADDRESS=replace-with-dev-world-chain-contract
PGHOST=postgres
PGPORT=5432
PGDATABASE=civilization_dev
PGUSER=civilization_dev
# PGPASSWORD is the application and migration-process database password.
PGPASSWORD=replace-with-dev-postgres-password
# POSTGRES_PASSWORD must have exactly the same value when initializing PostgreSQL.
POSTGRES_PASSWORD=replace-with-dev-postgres-password
