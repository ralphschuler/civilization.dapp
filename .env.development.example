# Public development Mini App values. Replace placeholders in your local runtime only.
WORLD_APP_ID=app_replace_with_development_mini_app_id

# WalletAuth/SIWE origin for the isolated development Mini App.
WALLET_AUTH_URL=https://civilization-dev.example.invalid

# Isolated World Chain development contract configuration.
CIVILIZATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CIVILIZATION_CHAIN_ID=480
CIVILIZATION_WORLD_TOKEN_ADDRESS=0x2cFc85d8E48F8EAB294be644d9E25C3030863003

# PostgreSQL challenge store. Do not use production credentials.
PGHOST=civilization-dev-postgres
PGPORT=5432
PGDATABASE=civilization_dev
PGUSER=civilization_dev
POSTGRES_PASSWORD=replace-with-a-local-development-password
